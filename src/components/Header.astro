---
import Logo from './Logo.astro';
const menus = [
  { t: 'Producto', items: [['Plataforma','/producto'],['Analítica con IA','/producto#ia'],['SDK y API','/producto#sdk'],['Seguridad','/producto#gobierno']] },
  { t: 'Soluciones', items: [['Para SaaS','/producto#saas'],['Para equipos de datos','/producto#datos'],['White-label','/producto#marca']] },
  { t: 'Recursos', items: [['Demos','/demos'],['Guías y blog','/recursos'],['Casos de éxito','/recursos#casos']] },
];
---
<header class="hdr">
  <div class="wrap">
    <Logo />
    <button class="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
    <nav class="nav" id="nav" aria-label="Principal">
      {menus.map(m => (
        <details class="dd">
          <summary>{m.t}</summary>
          <div class="menu">{m.items.map(([l,h]) => <a href={h}>{l}</a>)}</div>
        </details>
      ))}
      <a href="/contacto">Ayuda</a>
      <a href="/precios">Precios</a>
      <a class="btn mcta" href="/contacto">Solicitar demo</a>
    </nav>
    <a class="btn cta" href="/contacto">Solicitar demo</a>
  </div>
</header>
