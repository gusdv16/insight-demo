---
const { chat = true } = Astro.props;
const bars = [38,52,44,70,58,82,66,90,74,96,80,70];
const kpis = [['1.497','Usuarios',136],['503','Pedidos',266],['131.225','Ingresos',396]];
---
<svg class="mock" viewBox="0 0 640 400" role="img" aria-label="Ilustración de un panel de analítica con gráficos de barras y línea" width="640" height="400">
  <rect width="640" height="400" rx="14" fill="#fff"/>
  <rect width="110" height="400" rx="14" fill="#2a3144"/><rect x="96" width="14" height="400" fill="#2a3144"/>
  <rect x="20" y="22" width="70" height="14" rx="4" fill="#8fa2ff"/>
  {[70,100,130,160].map(y => <rect x="20" y={y} width="70" height="10" rx="5" fill="#44506b"/>)}
  <text x="136" y="40" font-size="15" font-weight="700" fill="#414141" font-family="sans-serif">Rendimiento de ventas</text>
  {kpis.map(([v,l,x]) => (
    <g><rect x={x} y="56" width="116" height="62" rx="10" fill="#f6f7fa"/><text x={Number(x)+12} y="86" font-size="22" font-weight="700" fill="#2b46bb" font-family="sans-serif">{v}</text><text x={Number(x)+12} y="106" font-size="11" fill="#6b7280" font-family="sans-serif">{l}</text></g>
  ))}
  <rect x="526" y="56" width="100" height="62" rx="10" fill="#fff4ea"/><text x="538" y="92" font-size="12" fill="#c76a1b" font-family="sans-serif">+12,4 % mes</text>
  <rect x="136" y="134" width="300" height="200" rx="10" fill="#fff" stroke="#e4e7ee"/>
  {bars.map((h,i) => <rect x={152+i*23} y={320-h*1.6} width="14" height={h*1.6} rx="3" fill={i%2 ? '#f59a4a' : '#e8548a'} opacity=".9"/>)}
  <rect x="452" y="134" width="174" height="200" rx="10" fill="#fff" stroke="#e4e7ee"/>
  <polyline points="466,300 490,270 514,282 538,240 562,252 586,200 610,176" fill="none" stroke="#2b46bb" stroke-width="3" stroke-linejoin="round"/>
  {[[466,300],[538,240],[610,176]].map(([x,y]) => <circle cx={x} cy={y} r="4" fill="#2b46bb"/>)}
  {chat && <g>
    <rect x="136" y="300" width="250" height="84" rx="12" fill="#fff" stroke="#e4e7ee"/>
    <circle cx="156" cy="322" r="9" fill="#e8548a"/><text x="172" y="326" font-size="11" font-weight="700" fill="#414141" font-family="sans-serif">Pregunta al asistente</text>
    <rect x="148" y="338" width="226" height="22" rx="6" fill="#f6f7fa"/><text x="156" y="353" font-size="10" fill="#6b7280" font-family="sans-serif">¿Cuál es la proyección de ventas?</text>
    <rect x="148" y="366" width="140" height="8" rx="4" fill="#e4e7ee"/>
  </g>}
</svg>
