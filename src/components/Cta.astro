---
const { title = 'Lleva la analítica a tu producto', text = 'Empieza hoy con conversaciones de datos, paneles y métricas dentro de tu aplicación.' } = Astro.props;
---
<section class="section bg-blue center">
  <div class="wrap rv">
    <h2>{title}</h2>
    <p class="lead" style="color:#dfe5ff">{text}</p>
    <a class="btn white" href="/contacto">Solicitar una demo</a>
  </div>
</section>
