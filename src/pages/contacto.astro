---
import Base from '../layouts/Base.astro';
---
<Base title="Solicitar demo | Insight Demo">
  <section class="section page-hero"><div class="wrap" style="max-width:640px"><h1 class="center">Solicita una <span class="grad">demo</span></h1><p class="lead center">Formulario de muestra: no envía datos a ningún sitio.</p>
    <form class="card" onsubmit="event.preventDefault();this.querySelector('.ok').hidden=false">
      <style>form label{display:block;font-weight:500;margin-bottom:14px;font-size:.9rem}form input,form textarea{display:block;width:100%;margin-top:6px;padding:12px;border:1px solid var(--line);border-radius:10px;font:inherit}.ok{color:#1b7a4a;margin-top:14px}</style>
      <label>Nombre<input name="n" required autocomplete="name"/></label>
      <label>Correo<input type="email" name="e" required autocomplete="email"/></label>
      <label>Mensaje<textarea name="m" rows="4"></textarea></label>
      <button class="btn" type="submit">Enviar</button>
      <p class="ok" hidden>Gracias, esto es solo una demostración: no se guardó nada.</p>
    </form></div></section>
</Base>
